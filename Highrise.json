{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/theme/1.0.0/schema.json",
  "name": "Executive Dark Pro",
  "dataColors": [
    "#00D2FF",
    "#10B981",
    "#F59E0B",
    "#EF4444",
    "#818CF8",
    "#38BDF8",
    "#F43F5E",
    "#34D399",
    "#A78BFA",
    "#FB923C",
    "#06B6D4",
    "#60A5FA"
  ],
  "background": "#0B1120",
  "foreground": "#F8FAFC",
  "foregroundNeutralSecondary": "#CBD5E1",
  "foregroundNeutralTertiary": "#94A3B8",
  "backgroundLight": "#1E293B",
  "backgroundNeutral": "#334155",
  "tableAccent": "#00D2FF",
  "good": "#10B981",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "maximum": "#10B981",
  "center": "#F59E0B",
  "minimum": "#EF4444",
  "null": "#64748B",
  "textClasses": {
    "callout": {
      "fontSize": 20,
      "fontFace": "Segoe UI Semibold",
      "color": "#00D2FF"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#F8FAFC"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI",
      "color": "#E2E8F0"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#94A3B8"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 50,
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1E293B"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#94A3B8"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#0B1120"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0B1120"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0B1120"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#00D2FF"
              }
            },
            "fontSize": 20
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "fontSize": 10
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "radius": 8
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            }
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "background": {
              "solid": {
                "color": "#1E293B"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0F172A"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1E293B"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#162032"
              }
            }
          }
        ],
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#334155"
              }
            },
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#334155"
              }
            }
          }
        ]
      }
    }
  }
}